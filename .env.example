# ── MLOps Fine-Tuning Hub — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Required: HuggingFace token to download base models ─────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── S3 integration (set S3_BUCKET to enable cloud storage) ──────────────────
# Leave S3_BUCKET empty to run fully locally (no S3 needed).
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# ── AWS credentials (leave blank if running on EC2 with an IAM Role — recommended) ──
# On EC2 with IAM Role attached: do NOT set these. The role provides credentials automatically.
# Only set these if running locally or without an IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── MLflow tracking URI (default: local SQLite — fine for single EC2 setup) ─
# MLFLOW_TRACKING_URI=sqlite:////app/mlflow.db
